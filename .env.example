PORT=3000
SELF_BASE_URL=http://localhost:3000
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL, if set, takes precedence over REDIS_HOST/REDIS_PORT (used by
# managed providers like Render's Key Value store, e.g. redis://user:pass@host:port)
REDIS_URL=
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offer-task-queue
SUPPLIER_TIMEOUT_MS=5000
HOTELS_CACHE_TTL_SECONDS=300
